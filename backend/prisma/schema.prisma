generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id          				String   	@id
  username    				String   	@unique
  hashPassword 				String

	firstName  					String?
  lastName   					String?
	age									Int?
	personalInfo				String?
	dateOfBirth				  DateTime? @default(now())
  dateOfRegistration  DateTime? @default(now())
}
